# Copy to .env for local development. On Vercel, set these in the project's environment variables.

# --- Database (Neon Postgres) ---
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/files?sslmode=require"
# Direct (unpooled) connection string, used only by Prisma migrations from your laptop. Optional locally.
DIRECT_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/files?sslmode=require"

# --- Sign-in (Auth.js with Microsoft Entra ID) ---
# Random secret that signs session cookies, at least 32 characters: openssl rand -base64 32
AUTH_SECRET=""
# The app's public URL, e.g. https://files.example.com (http://localhost:3000 locally).
AUTH_URL="http://localhost:3000"
# Application (client) ID of the Entra app registration.
AUTH_MICROSOFT_ENTRA_ID_ID=""
# A client secret value from that app registration.
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Prefer the company's own tenant: https://login.microsoftonline.com/<tenant id>/v2.0. Microsoft then
# turns away every other organisation before it reaches the app. The multi-tenant issuer below works
# with the sibling apps' shared registration, but then AUTH_ALLOWED_TENANT_IDS is required.
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/organizations/v2.0"
# Entra tenant ids (GUIDs, comma-separated) whose accounts may sign in. Anyone else is turned away
# before their email is even looked at, because Microsoft does not verify the email claim across
# tenants. Find a company's id at https://login.microsoftonline.com/<its domain>/v2.0/.well-known/openid-configuration
AUTH_ALLOWED_TENANT_IDS=""

# --- AI (Claude) ---
# Anthropic API key from https://platform.claude.com. Set a spend limit in the console as well.
ANTHROPIC_API_KEY=""
# Model that reads and files each upload. Must be in src/lib/ai-prices.ts, or the app refuses to start it.
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Cheaper model used for folder suggestions and AI search.
ANTHROPIC_MODEL_LIGHT="claude-haiku-5-5"
# Claude calls allowed per company per day (company time zone); new calls stop when reached. 0 switches the AI off.
AI_MAX_CALLS_PER_DAY="500"
# Default spend caps in USD. Admins can set different caps per company and per person in Usage.
AI_DAILY_USD="10"
AI_MONTHLY_USD="150"
AI_USER_DAILY_USD="2"
AI_USER_MONTHLY_USD="30"
# The most any cap can be set to in Usage. Only these variables can raise it.
AI_DAILY_USD_MAX="50"
AI_MONTHLY_USD_MAX="500"

# --- File storage (Cloudflare R2 or any S3-compatible bucket) ---
# R2: https://<account id>.r2.cloudflarestorage.com
FILES_S3_ENDPOINT=""
# "auto" for R2; the bucket's region for other providers.
FILES_S3_REGION="auto"
# Private bucket name.
FILES_S3_BUCKET=""
# Access key ID of an API token scoped to the bucket (Object Read & Write).
FILES_S3_ACCESS_KEY_ID=""
# Secret access key of that token.
FILES_S3_SECRET_ACCESS_KEY=""

# --- Limits (optional; defaults shown) ---
# Largest file a user may upload, in megabytes (at most about 1900). Files the AI does not read wait in Review.
FILES_MAX_MB="1900"
# Largest file the AI reads, in megabytes; above this the uploader writes the summary.
FILES_AI_MAX_MB="22"
# AI searches (Ask) per user per day.
FILES_AI_SEARCHES_PER_USER_PER_DAY="50"

# --- Housekeeping ---
# Bearer token Vercel Cron sends to /api/cron/sweep (daily: abandoned uploads, files deleted over 30
# days ago). At least 16 characters: openssl rand -base64 32. Without it the sweep does not run.
CRON_SECRET=""
# Reserved (not used yet): would encrypt extracted file text at rest. 32 random bytes, base64.
DATA_ENCRYPTION_KEY=""

# --- Email attachments from the Email Tracker ---
# Bearer token the tracker sends to /api/integrations/email-attachments (the tracker's FILES_API_KEY: the same value in
# both apps). At least 32 characters: openssl rand -base64 32. Without it, attachments are refused.
FILES_INTEGRATION_API_KEY=""
