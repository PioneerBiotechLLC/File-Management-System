generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  editor
  viewer
}

enum FileStatus {
  uploading
  processing
  ready
  needs_review
  failed
}

enum FileReadStatus {
  full
  partial
  not_read
}

enum FolderAccess {
  everyone
  restricted
}

enum FileSource {
  upload
  email_attachment
}

enum AiPurpose {
  file_analysis
  file_search
}

enum PartySide {
  customer
  supplier
}

/// regular: made by an admin or seeded. The rest are created when a document is filed:
/// year (2026) / side (Customers, Suppliers) / party (Gulf Pharmacy) / doc (Invoices).
enum FolderKind {
  regular
  year
  side
  party
  doc
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  domain       String   @unique
  timezone     String   @default("Asia/Dubai")
  logoUrl      String?
  primaryColor String?
  /// AI spend caps in USD; null means the AI_DAILY_USD / AI_MONTHLY_USD defaults.
  aiDailyUsd   Float?
  aiMonthlyUsd Float?
  createdAt    DateTime @default(now())

  memberships Membership[]
  folders     Folder[]
  files       StoredFile[]
  auditLogs   AuditLog[]
  aiUsage     AiUsage[]
  parties     Party[]
}

/// A customer or supplier. A company that is both is two parties, one per side.
model Party {
  id        String    @id @default(cuid())
  orgId     String
  side      PartySide
  name      String
  /// The name folded for matching (lowercase, no punctuation or LLC/FZE-style suffixes).
  key       String
  /// Other spellings seen on documents, folded the same way.
  aliases   String[]  @default([])
  createdBy String
  createdAt DateTime  @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folders Folder[]
  files   StoredFile[]

  @@unique([orgId, side, key])
}

model AppUser {
  id          String    @id @default(cuid())
  /// Always lowercase; the identity shared with the sibling apps.
  email       String    @unique
  name        String?
  isOwner     Boolean   @default(false)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  /// The Microsoft account that first signed in as this user: its tenant and object ids. Later
  /// sign-ins must come from the same account, so a matching email from elsewhere is refused.
  entraTid    String?
  entraOid    String?

  memberships Membership[]
  grants      FolderGrant[]
  uploads     StoredFile[]

  @@unique([entraTid, entraOid])
}

model Membership {
  id           String @id @default(cuid())
  userId       String
  orgId        String
  role         Role
  /// This person's AI spend caps in USD; null means the AI_USER_DAILY_USD / AI_USER_MONTHLY_USD defaults.
  aiDailyUsd   Float?
  aiMonthlyUsd Float?

  user AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model AuditLog {
  id         String   @id @default(cuid())
  /// Null for actions that are not tied to one company, such as making someone an owner.
  orgId      String?
  userEmail  String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model AiUsage {
  id               String    @id @default(cuid())
  orgId            String
  userId           String?
  fileId           String?
  purpose          AiPurpose
  model            String
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  cacheReadTokens  Int       @default(0)
  cacheWriteTokens Int       @default(0)
  /// An estimate is set aside here while the call runs, then replaced by the real cost.
  costUsd          Float     @default(0)
  error            String?
  createdAt        DateTime  @default(now())
  /// Null while the call is in flight.
  finishedAt       DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, userId, purpose, createdAt])
}

model Folder {
  id          String       @id @default(cuid())
  orgId       String
  /// Null for a top-level folder.
  parentId    String?
  name        String
  nameAr      String?
  /// What belongs here, in plain words. Claude files by this, so it matters more than the name.
  description String?
  access      FolderAccess @default(everyone)
  sortOrder   Int          @default(0)
  /// Never hard-delete a folder that held files.
  isActive    Boolean      @default(true)
  createdBy   String
  createdAt   DateTime     @default(now())
  kind        FolderKind   @default(regular)
  /// Set on year folders and everything under them.
  year        Int?
  /// Set on side, party and doc folders.
  side        PartySide?
  /// Set on party and doc folders.
  partyId     String?
  /// Set on doc folders: an id from file-kinds.ts DOC_KINDS.
  docKind     String?

  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  party          Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  parent         Folder?       @relation("FolderTree", fields: [parentId], references: [id], onDelete: NoAction)
  children       Folder[]      @relation("FolderTree")
  grants         FolderGrant[]
  files          StoredFile[]  @relation("FileFolder")
  suggestedFiles StoredFile[]  @relation("FileSuggestedFolder")

  /// The migration creates this index with NULLS NOT DISTINCT so two top-level folders cannot share a name.
  @@unique([orgId, parentId, name])
  @@index([orgId, parentId])
}

/// Who may see a restricted folder and everything under it. Admins and owners always can.
model FolderGrant {
  id       String  @id @default(cuid())
  folderId String
  userId   String
  canWrite Boolean @default(false)

  folder Folder  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@index([userId])
}

model StoredFile {
  id                  String          @id @default(cuid())
  orgId               String
  /// Null while unfiled.
  folderId            String?
  /// Display name, editable.
  name                String
  originalName        String
  mimeType            String
  sizeBytes           Int
  /// Duplicate detection within the company.
  sha256              String
  currentVersion      Int             @default(1)
  status              FileStatus      @default(uploading)
  readStatus          FileReadStatus?
  source              FileSource      @default(upload)
  sourceRef           String?
  title               String?
  /// 2–4 sentences in the file's language, plus one English line when it is Arabic.
  summary             String?
  /// quotation | purchase_order | invoice | coa | contract | certificate | report | letter | specification | price_list | other
  docType             String?
  docDate             DateTime?
  /// en | ar | mixed | other
  language            String?
  /// { parties:[], references:[{kind,value}], amounts:[{value,currency}], products:[], expiryDate? }
  facts               Json            @default("{}")
  tags                String[]        @default([])
  suggestedFolderId   String?
  /// The AI's customer/supplier suggestion: { side, partyId, partyName, docKind }.
  suggestedTrading    Json?
  /// The customer or supplier the file is filed under, if any.
  partyId             String?
  filingConfidence    Float?
  /// One short sentence shown to the user.
  filingReason        String?
  /// The email of the user whose choice placed the file.
  filedBy             String?
  aiModel             String?
  /// Why the AI did not read the file, or what went wrong; shown to the uploader.
  aiError             String?
  attempts            Int             @default(0)
  /// Set while the AI is reading the file; stale after two minutes.
  processingStartedAt DateTime?
  /// When and by whom the summary was checked and confirmed; a file is filed only after this.
  summaryConfirmedAt  DateTime?
  summaryConfirmedBy  String?
  searchVector        Unsupported("tsvector")?
  uploadedBy          String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  /// Soft delete; purged from storage after 30 days.
  deletedAt           DateTime?

  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder          Folder?       @relation("FileFolder", fields: [folderId], references: [id], onDelete: SetNull)
  suggestedFolder Folder?       @relation("FileSuggestedFolder", fields: [suggestedFolderId], references: [id], onDelete: SetNull)
  uploader        AppUser       @relation(fields: [uploadedBy], references: [id])
  party           Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  versions        FileVersion[]

  @@index([orgId, folderId, deletedAt])
  @@index([orgId, partyId])
  @@index([orgId, status])
  @@index([orgId, sha256])
  @@index([searchVector], type: Gin)
}

/// A version with versionNo above its file's currentVersion is an upload that has not been confirmed yet.
model FileVersion {
  id           String   @id @default(cuid())
  fileId       String
  versionNo    Int
  sizeBytes    Int
  sha256       String
  /// Null on rows created before versions recorded them; the file's own values apply then.
  originalName String?
  mimeType     String?
  uploadedBy   String
  createdAt    DateTime @default(now())

  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, versionNo])
}
